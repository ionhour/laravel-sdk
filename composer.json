{
    "name": "ionhour/laravel",
    "description": "Laravel SDK for Ionhour — uptime & cron heartbeat monitoring. Register jobs and ping success/fail with automatic retries and scheduler integration.",
    "keywords": [
        "ionhour",
        "monitoring",
        "uptime",
        "heartbeat",
        "cron",
        "laravel"
    ],
    "homepage": "https://ionhour.com",
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/ionhour/laravel/issues",
        "source": "https://github.com/ionhour/laravel",
        "docs": "https://docs.ionhour.com"
    },
    "authors": [
        {
            "name": "Ionhour",
            "homepage": "https://ionhour.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ionhour\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ionhour\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ionhour\\Laravel\\IonhourServiceProvider"
            ],
            "aliases": {
                "Ionhour": "Ionhour\\Laravel\\Facades\\Ionhour"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
